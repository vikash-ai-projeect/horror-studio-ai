
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Horror Studio AI</title>
<style>
body {
  font-family: Arial, sans-serif;
  background: #111318;
  color: #f5f5f5;
  max-width: 760px;
  margin: 40px auto;
  padding: 20px;
}
h1 { color: #ff6262; }
p { color: #c5c7ce; line-height: 1.6; }
label { display: block; margin-top: 18px; }
input, select, button, textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 12px;
  margin-top: 8px;
  border-radius: 7px;
  font-size: 16px;
}
input, select, textarea {
  background: #20232b;
  color: white;
  border: 1px solid #50535e;
}
button {
  background: #e54848;
  color: white;
  border: none;
  cursor: pointer;
  margin-top: 18px;
}
button:hover { background: #c93636; }
#output { min-height: 260px; line-height: 1.6; }
</style>
</head>
<body>
<h1>Horror Studio AI</h1>
<p>Create horror story briefs and cinematic video prompts
for your YouTube channel.</p>

<label for="topic">Story idea</label>
<input id="topic" placeholder="Example: Room 204">

<label for="setting">Location</label>
<select id="setting">
  <option>Indian city apartment</option>
  <option>Indian village</option>
  <option>Abandoned hotel</option>
  <option>Old hospital</option>
</select>

<label for="duration">Video duration</label>
<select id="duration">
  <option value="1">1 minute</option>
  <option value="5">5 minutes</option>
  <option value="10" selected>10 minutes</option>
</select>

<button onclick="generatePrompt()">Generate Story Prompt</button>

<label for="output">Your generated prompt</label>
<textarea id="output" rows="16"
placeholder="Your prompt will appear here..."></textarea>

<button onclick="copyPrompt()">Copy Prompt</button>

<p>Version 1.0 — An open-source project for horror creators.</p>

<script>
function generatePrompt() {
  const topic = document.getElementById("topic").value.trim();
  const setting = document.getElementById("setting").value;
  const minutes = Number(document.getElementById("duration").value);

  if (!topic) {
    alert("Please enter a story idea first.");
    return;
  }

  const scenes = minutes * 12;

  const prompt = `Act as an expert horror storyteller and
cinematic animation prompt writer.

STORY IDEA: ${topic}
SETTING: ${setting}
DURATION: ${minutes} minutes
SCENES: ${scenes}
SCENE LENGTH: 5 seconds each

INSTRUCTIONS:
1. Write an original psychological horror story.
2. Use slow-burn suspense, silence and unsettling repetition.
3. Avoid cheap jump scares and excessive darkness.
4. Keep important characters and locations consistent.
5. Use semi-realistic 2D cinematic animation, clean outlines,
gentle shading and smooth gradients.
6. Keep scenes clearly visible with balanced lighting.
7. Use slow camera pushes, lateral glides and meaningful stillness.
8. Include narration, visual descriptions and camera movements.
9. Give each scene a separate image prompt and video prompt.
10. Make the ending memorable and unsettling.

First provide a short story outline, then develop all
${scenes} scenes. Each scene should last 5 seconds.`;

  document.getElementById("output").value = prompt;
}

async function copyPrompt() {
  const output = document.getElementById("output");
  if (!output.value) {
    alert("Generate a prompt first.");
    return;
  }

  try {
    await navigator.clipboard.writeText(output.value);
    alert("Prompt copied successfully!");
  } catch (error) {
    output.select();
    alert("Select and copy the prompt using Ctrl+C.");
  }
}
</script>
</body>
</html>
